# Auth Security
APP_PASSWORD="admin"
SECURE_COOKIES="true" # Set to false if running production build over HTTP

# Database connection string
DATABASE_URL="postgresql://budgetuser:budgetpassword@localhost:5433/webbudget"

# AI Configuration (OpenAI compatible)
OPENAI_BASE_URL="https://ai-url-here/api/v1"
OPENAI_API_KEY="your-api-key-here"
AI_MODEL="gemma4:e4b"
OPENAI_CHAT_ID="webbudget-session-id" # Optional/Required for Open WebUI custom domains. Standard APIs (OpenAI, Groq, DeepSeek) that reject this parameter will automatically fallback and retry without it.

# NextAuth configuration (Legacy/Compatibility)
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Internal API Key for Background Sync
NEXT_PUBLIC_INTERNAL_API_KEY="your-internal-key-here"

# RentCast API Configuration
RENTCAST_API_KEY="your-rentcast-api-key-here"

# OpenID Connect (Authentik) Configuration
OIDC_ENABLED="false"
OIDC_ADMIN_GROUP="authentik Admins"
OIDC_REQUIRED_GROUP="authentik Admins"
OIDC_RP_CLIENT_ID="coinflow-oidc-client"
OIDC_RP_CLIENT_SECRET="change-me-in-infisical"
OIDC_OP_AUTHORIZATION_ENDPOINT="https://auth.castertr0y357.net/application/o/authorize/"
OIDC_OP_TOKEN_ENDPOINT="https://auth.castertr0y357.net/application/o/token/"
OIDC_OP_USER_ENDPOINT="https://auth.castertr0y357.net/application/o/userinfo/"
OIDC_OP_JWKS_ENDPOINT="https://auth.castertr0y357.net/application/o/coinflow/jwks/"
OIDC_OP_LOGOUT_ENDPOINT="https://auth.castertr0y357.net/application/o/coinflow/end-session/"


