apiVersion: v1
kind: Secret
metadata:
  name: coinflow-secret
type: Opaque
stringData:
  POSTGRES_USER: "budgetuser"
  POSTGRES_PASSWORD: "change-me-to-a-secure-database-password"
  NEXTAUTH_SECRET: "change-me-to-a-random-nextauth-secret"
  APP_PASSWORD: "change-me-to-a-secure-app-password"
  OPENAI_API_KEY: "change-me-to-your-openai-or-ollama-api-key"
  RENTCAST_API_KEY: "change-me-to-your-rentcast-api-key"
  NEXT_PUBLIC_INTERNAL_API_KEY: "change-me-to-your-internal-api-key"
